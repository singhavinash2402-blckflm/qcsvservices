# Public address of the site. Use the host you chose as the main one.
NEXT_PUBLIC_SITE_URL=https://www.qcsvservices.in

# Set to "true" on the production deployment only after client sign-off.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Enquiry form email (Resend). Keep real values in .env.local and in the
# hosting settings. Never commit them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@qcsvservices.in
CONTACT_FROM_EMAIL="QCSV Services Website <website@qcsvservices.in>"
